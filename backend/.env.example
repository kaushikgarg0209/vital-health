# Supabase (from dashboard or `supabase status` for local dev)
SUPABASE_URL=http://127.0.0.1:54321 
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (local Docker — start with `docker compose up -d` from repo root)
REDIS_URL=redis://localhost:6379

# Signed URL TTL for private document downloads (seconds)
SIGNED_URL_TTL_SECONDS=3600

# App
NODE_ENV=development
PORT=3001
# Must match the browser URL (production: https://your-app.vercel.app)
FRONTEND_URL=http://127.0.0.1:3000
# Optional — CORS origin for cookie-based auth (defaults to FRONTEND_URL)
# Optional — defaults to http://localhost:PORT
# BASE_URL=http://localhost:3001

# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Models with free-tier quota (check https://ai.dev/rate-limit for your key)
# gemini-2.0-flash / gemini-2.5-flash may be unavailable for new API keys
GEMINI_CLASSIFICATION_MODEL=gemini-3.1-flash-lite
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite